APP_ENV=development
# SQLite by default. For PostgreSQL change only this line, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/care_circle
DATABASE_URL=sqlite:///./care_circle.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173
